# 应用运行地址
APP_URL="http://localhost:3000"

# Auth.js 本地开发 secret。请生成自己的高熵值，绝不要提交真实 secret。
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Docker Compose 默认开发数据库；也可替换为自行管理的 PostgreSQL 连接。
DATABASE_URL="postgresql://our_space:our_space_dev@localhost:5432/our_space?schema=public"

# 测试必须使用独立数据库，避免污染开发数据。
TEST_DATABASE_URL="postgresql://our_space:our_space_test@localhost:5432/our_space_test?schema=public"

# 头像专用外部处理；空值默认关闭，未配置仍可正常进入 Home。
# 仅本人照片与固定头像提示；不得填入 Space 数据。
AVATAR_PROVIDER="cloudflare-flux-klein"
# 外部调用独立开关：本轮额度已用完，必须保持 false；后续明确授权后才启用。
AVATAR_EXTERNAL_REQUESTS_ENABLED="false"
AVATAR_EXTERNAL_PROCESSING_APPROVED=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# 仅在实际账户确认使用 Workers Free 后填写 free；此变量不是账单验证。
CLOUDFLARE_WORKERS_PLAN=""
# 必须是持久、私密且排除备份的绝对目录，不得位于 public 内。
AVATAR_STORAGE_DIR=""

# 地图只发送主动选择的公共浏览区域，不包含 Resident/Presence/定位。
# 新部署默认空；当前项目已获开发/测试/早期低流量授权，启用时填写 osm-overpass-area-only-v1。
MAP_EXTERNAL_PROCESSING_APPROVED=""
# 公共地理缓存；默认 .data/map-cache，与私密头像存储独立。
MAP_CACHE_DIR=""

# 仅服务端配置；公共实例不承诺商业生产 SLA，商业/规模化前须重新评估。
MAP_OVERPASS_ENDPOINT="https://overpass-api.de/api/interpreter"
# 可选的逗号分隔运维批准 HTTPS 端点；单次读取只请求一个端点，后续读取才可在 circuit backoff 后选择 fallback。
MAP_OVERPASS_FALLBACK_ENDPOINTS=""
