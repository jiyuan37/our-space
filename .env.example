# 应用运行地址
APP_URL="http://localhost:3000"

# Auth.js 本地开发 secret。请生成自己的高熵值，绝不要提交真实 secret。
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Docker Compose 默认开发数据库；也可替换为自行管理的 PostgreSQL 连接。
DATABASE_URL="postgresql://our_space:our_space_dev@localhost:5432/our_space?schema=public"

# 测试必须使用独立数据库，避免污染开发数据。
TEST_DATABASE_URL="postgresql://our_space:our_space_test@localhost:5432/our_space_test?schema=public"
